        <mxCell id="221" parent="WD2dRAa4dLDvtk7R4Zzs-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Candle anatomy (expanded)&#xa;           Czym są te cechy i co widzi model:&#xa;&#xa;           • body_norm_rng = |close−open| / (high−low)&#xa;             → Przykład: małe body przy dużym zakresie&#xa;             → Model widzi: niska decyzyjność, dużo walki&#xa;&#xa;           • upper_wick_norm_rng = (high−max(open,close)) / (high−low)&#xa;             → Przykład: długi górny cień&#xa;             → Model widzi: silne odrzucenie wzrostu&#xa;&#xa;           • lower_wick_norm_rng = (min(open,close)−low) / (high−low)&#xa;             → Przykład: długi dolny cień&#xa;             → Model widzi: agresywną obronę dołów&#xa;&#xa;           • direction = sign(close−open)&#xa;             → Przykład: świeca zielona / czerwona&#xa;             → Model widzi: kto wygrał świecę (bez info jak trudno)" vertex="1">
          <mxGeometry height="260" width="420" y="240" as="geometry" />
        </mxCell>
        <mxCell id="200" parent="WD2dRAa4dLDvtk7R4Zzs-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" value="Feature semantics&#xa;What the model sees (intuicje + przykłady)" vertex="1">
          <mxGeometry height="70" width="420" as="geometry" />
        </mxCell>
        <mxCell id="210" parent="WD2dRAa4dLDvtk7R4Zzs-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Log-returns&#xa;Analogia: prędkość auta&#xa;Przykład na świeczkach: 100 → 102 → 104 (spójny ruch w górę)&#xa;Co model widzi: sekwencję małych dodatnich liczb → ciągły ruch w jednym kierunku (kierunek + tempo), bez poziomu ceny." vertex="1">
          <mxGeometry height="130" width="420" y="90" as="geometry" />
        </mxCell>
        <mxCell id="230" parent="WD2dRAa4dLDvtk7R4Zzs-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Volatility&#xa;Analogia: stan drogi&#xa;Przykład na świeczkach: ta sama świeca w spokojnym vs chaotycznym rynku&#xa;Co model widzi: miarę reżimu (np. ATR_rel / rolling_std_rel) → czy ruch jest duży czy normalny jak na obecne warunki; pomaga ważyć znaczenie innych cech." vertex="1">
          <mxGeometry height="150" width="420" y="510" as="geometry" />
        </mxCell>
        <mxCell id="240" parent="WD2dRAa4dLDvtk7R4Zzs-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Volume&#xa;Analogia: gaz / moc silnika&#xa;Przykład na świeczkach: ta sama świeca przy niskim vs wysokim volume&#xa;Co model widzi: rel_volume (np. volume / rolling_mean(volume)) → czy ruch był wsparty zaangażowaniem czy był „pusty”; wzmacnia/osłabia interpretację ruchu." vertex="1">
          <mxGeometry height="150" width="420" y="680" as="geometry" />
        </mxCell>
        <mxCell id="fs1" edge="1" parent="WD2dRAa4dLDvtk7R4Zzs-240" source="200" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=1;" target="210">
