        <mxCell id="221" parent="9NS86yXn8nBAM57oJv2T-240" style="rounded=1;whiteSpace=wrap;html=1;" value="Candle anatomy (expanded)&#10;           Czym są te cechy i co widzi model:&#10;&#10;           • body_norm_rng = |close−open| / (high−low)&#10;             → Przykład: małe body przy dużym zakresie&#10;             → Model widzi: niska decyzyjność, dużo walki&#10;&#10;           • upper_wick_norm_rng = (high−max(open,close)) / (high−low)&#10;             → Przykład: długi górny cień&#10;             → Model widzi: silne odrzucenie wzrostu&#10;&#10;           • lower_wick_norm_rng = (min(open,close)−low) / (high−low)&#10;             → Przykład: długi dolny cień&#10;             → Model widzi: agresywną obronę dołów&#10;&#10;           • direction = sign(close−open)&#10;             → Przykład: świeca zielona / czerwona&#10;             → Model widzi: kto wygrał świecę (bez info jak trudno)" vertex="1">
          <mxGeometry height="260" width="420" y="240" as="geometry" />
        </mxCell>
        <mxCell id="200" parent="9NS86yXn8nBAM57oJv2T-240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" value="Feature semantics&#10;What the model sees (intuicje + przykłady)" vertex="1">
          <mxGeometry height="70" width="420" as="geometry" />
        </mxCell>
        <mxCell id="210" parent="9NS86yXn8nBAM57oJv2T-240" style="rounded=1;whiteSpace=wrap;html=1;" value="Log-returns&#10;Analogia: prędkość auta&#10;Przykład na świeczkach: 100 → 102 → 104 (spójny ruch w górę)&#10;Co model widzi: sekwencję małych dodatnich liczb → ciągły ruch w jednym kierunku (kierunek + tempo), bez poziomu ceny." vertex="1">
          <mxGeometry height="130" width="420" y="90" as="geometry" />
        </mxCell>
        <mxCell id="230" parent="9NS86yXn8nBAM57oJv2T-240" style="rounded=1;whiteSpace=wrap;html=1;" value="Volatility&#10;Analogia: stan drogi&#10;Przykład na świeczkach: ta sama świeca w spokojnym vs chaotycznym rynku&#10;Co model widzi: miarę reżimu (np. ATR_rel / rolling_std_rel) → czy ruch jest duży czy normalny jak na obecne warunki; pomaga ważyć znaczenie innych cech." vertex="1">
          <mxGeometry height="150" width="420" y="510" as="geometry" />
        </mxCell>
        <mxCell id="240" parent="9NS86yXn8nBAM57oJv2T-240" style="rounded=1;whiteSpace=wrap;html=1;" value="Volume&#10;Analogia: gaz / moc silnika&#10;Przykład na świeczkach: ta sama świeca przy niskim vs wysokim volume&#10;Co model widzi: rel_volume (np. volume / rolling_mean(volume)) → czy ruch był wsparty zaangażowaniem czy był „pusty”; wzmacnia/osłabia interpretację ruchu." vertex="1">
          <mxGeometry height="150" width="420" y="680" as="geometry" />
        </mxCell>
        <mxCell id="fs1" edge="1" parent="9NS86yXn8nBAM57oJv2T-240" source="200" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=1;" target="210">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="241" value="&lt;div&gt;&lt;b&gt;5A. Feature Engineering (Classic ML)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Returns / log returns&lt;br&gt;• Volatility / ATR&lt;br&gt;• Candle anatomy (norm.)&lt;br&gt;• FeatureValidationRunner&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1900.0" y="-860.0" width="165.0" height="110" as="geometry" /></mxCell><mxCell id="242" value="&lt;div&gt;&lt;b&gt;5B. Przygotowanie sekwencji (Deep Learning)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Windowing (sliding)&lt;br&gt;• Tensor 3D (N,W,F)&lt;br&gt;• OHLCV/sekwencje + opc. FE&lt;br&gt;• Zgodność z walk-forward&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1725.0" y="-860.0" width="165.0" height="110" as="geometry" /></mxCell><mxCell id="243" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="50" target="241"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="244" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="50" target="242"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="245" value="&lt;div&gt;&lt;b&gt;7A. Time-based split (Classic ML)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Train / Val / Test&lt;br&gt;• Bez shuffle&lt;br&gt;• CSV export&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-750.0" y="-850.0" width="155.0" height="110" as="geometry" /></mxCell><mxCell id="246" value="&lt;div&gt;&lt;b&gt;7B. Walk-forward validation (DL)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Rolling/expanding window&lt;br&gt;• Retraining per segment&lt;br&gt;• Symulacja real-time&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColo