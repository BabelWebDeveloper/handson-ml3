=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1940.0" y="-460.0" width="185.0" height="110" as="geometry" /></mxCell><mxCell id="254" value="&lt;div&gt;&lt;b&gt;9B. Model (Deep Learning)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• MLP / CNN / LSTM / GRU&lt;br&gt;• Input: 3D (N,W,F)&lt;br&gt;• Keras/TensorFlow&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1745.0" y="-460.0" width="185.0" height="110" as="geometry" /></mxCell><mxCell id="255" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="90" target="253"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="256" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="90" target="254"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="257" value="&lt;div&gt;&lt;b&gt;10A. Trening (Classic ML)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• fit()&lt;br&gt;• Szybkie uczenie&lt;br&gt;• CV / seed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1290.0" y="-490.0" width="155.0" height="110" as="geometry" /></mxCell><mxCell id="258" value="&lt;div&gt;&lt;b&gt;10B. Trening (Deep Learning)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Epoki / batch size&lt;br&gt;• EarlyStopping&lt;br&gt;• LR scheduling&lt;br&gt;• Checkpointing&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-1125.0" y="-490.0" width="155.0" height="110" as="geometry" /></mxCell><mxCell id="259" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="100" target="257"><mxGeometry relative="1" as="geometry" /></mxCell>