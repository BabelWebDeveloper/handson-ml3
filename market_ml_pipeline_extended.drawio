        <mxCell id="60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="6. Ponowna walidacja danych&#10;• NaN / inf po cechach&#10;• Leakage check (shift/target)&#10;• Sanity checks cech" vertex="1">
