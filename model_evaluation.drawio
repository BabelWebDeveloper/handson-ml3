        <mxCell id="trading" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;" value="🟢 + Trading Extension&#xa;- worst_fold kluczowy&#xa;- Stabilność &gt; mean&#xa;- Backtest&#xa;- Sharpe, drawdown, expectancy&#xa;- Finalna walidacja na holdout" vertex="1">
          <mxGeometry height="160" width="450" x="895" y="810" as="geometry" />
