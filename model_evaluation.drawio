        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;" value="Framework Oceny Modelu ML&#xa;(Uniwersalne vs Klasyczny ML vs Deep Learning)" vertex="1">
          <mxGeometry height="40" width="700" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="baseline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;" value="🟢 BASELINE&#xa;- Zawsze wymagany&#xa;- Porównanie względem najprostszego modelu&#xa;- Uniwersalne dla ML, DL, RNN, Transformer" vertex="1">
          <mxGeometry height="120" width="350" x="145" y="350" as="geometry" />
        </mxCell>
        <mxCell id="gap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;" value="🟢 GENERALIZATION GAP&#xa;- Train vs Validation&#xa;- Overfitting / Underfitting&#xa;- W DL: train_loss vs val_loss&#xa;- Uniwersalne" vertex="1">
          <mxGeometry height="120" width="350" x="545" y="350" as="geometry" />
        </mxCell>
        <mxCell id="stability" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;" value="🟢 STABILNOŚĆ&#xa;- std_test_score&#xa;- Najgorszy fold&#xa;- W DL: różne seedy / rolling validation&#xa;- Krytyczne w tradingu" vertex="1">
          <mxGeometry height="140" width="350" x="945" y="350" as="geometry" />
        </mxCell>
        <mxCell id="classic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;" value="🔵 KLASYCZNY ML (scikit-learn)&#xa;- RandomizedSearchCV&#xa;- TimeSeriesSplit&#xa;- cv_results_&#xa;- mean_test_score, rank_test_score&#xa;- Hiperparametry: max_depth, min_samples_leaf, itp." vertex="1">
          <mxGeometry height="180" width="400" x="120" y="590" as="geometry" />
